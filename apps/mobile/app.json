{
  "expo": {
    "name": "Paraggi",
    "slug": "paraggi",
    "scheme": "paraggi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.paraggi.mobile",
      "buildNumber": "24",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Paraggi usa la posizione per mostrare contenuti e chat solo con persone realmente vicine.",
        "NSPhotoLibraryUsageDescription": "Paraggi usa la galleria solo per allegare media ai post locali."
      }
    },
    "android": {
      "package": "app.paraggi.mobile",
      "versionCode": 24,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Paraggi usa la posizione per abilitare feed e chat locali."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Paraggi usa la galleria solo per allegare media ai post locali."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1f0f62a5-23c0-4f59-842c-26cd6e696d49"
      }
    }
  }
}
