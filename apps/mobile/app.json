{
  "expo": {
    "name": "Paraggi",
    "slug": "paraggi",
    "scheme": "paraggi",
    "version": "1.0.0",
    "icon": "./assets/paraggi-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#3B82C4",
      "barStyle": "light-content",
      "translucent": true
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.paraggi.mobile",
      "buildNumber": "100",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Paraggi usa la posizione per mostrare contenuti e chat solo con persone realmente vicine.",
        "NSPhotoLibraryUsageDescription": "Paraggi usa la galleria solo per allegare media ai post locali."
      }
    },
    "android": {
      "package": "app.paraggi.mobile",
      "versionCode": 100,
      "adaptiveIcon": {
        "foregroundImage": "./assets/paraggi-icon.png",
        "backgroundColor": "#3B82C4"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Paraggi usa la posizione per abilitare feed e chat locali."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Paraggi usa la galleria solo per allegare media ai post locali."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Paraggi usa il microfono solo quando registri una nota vocale da allegare a un post."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1f0f62a5-23c0-4f59-842c-26cd6e696d49"
      }
    }
  }
}
