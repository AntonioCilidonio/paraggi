{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@paraggi/domain": ["packages/domain/src/index.ts"],
      "@paraggi/application": ["packages/application/src/index.ts"],
      "@paraggi/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@paraggi/ui": ["packages/ui/src/index.ts"]
    }
  }
}
